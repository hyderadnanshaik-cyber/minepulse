# MINEGUARD — Microsoft Azure Production Environment Configuration

# Azure Database for PostgreSQL Flexible Server (Burstable B1ms)
DATABASE_URL=postgresql+asyncpg://mineguardadmin:MineSafety2026!Azure@mineguard-sih-pg.postgres.database.azure.com:5432/mine_monitoring
AZURE_POSTGRES_SSL=true

# Environment
ENVIRONMENT=production
PROJECT_NAME=MINEGUARD — Mine Subsidence Monitoring Backend
VERSION=1.0.0
API_PREFIX=/api

# Azure Application Insights Connection String
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://centralindia-0.in.applicationinsights.azure.com/

# MQTT (Edge LoRa Gateway upstream forwarding)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# CORS Allowed Origins
CORS_ORIGINS=https://mineguard-sih-api.azurewebsites.net,http://localhost:5173,http://127.0.0.1:5173,http://10.0.2.2:8000
