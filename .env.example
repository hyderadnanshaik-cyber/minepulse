# === Frontend (Vite VITE_ prefix required) ===
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Local Raspberry Pi gateway URL (offline mode)
VITE_GATEWAY_LOCAL_URL=http://192.168.4.1:8000

# === Backend (FastAPI) ===
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@localhost:5432/mine_monitoring
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@localhost:5432/mine_monitoring

# MQTT Broker (local Mosquitto)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Firebase Admin SDK (JSON string or path to service account file)
FIREBASE_SERVICE_ACCOUNT_JSON=
# OR:
FIREBASE_CREDENTIALS_PATH=

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://192.168.4.1

# Environment
ENVIRONMENT=development

# Email notifications (optional, cloud-only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS (optional, cloud-only)
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM=

# Gateway
GATEWAY_API_KEY=
ALARM_GPIO_PIN=18
