# Database connection strings (PostgreSQL 18 + PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mine_monitoring
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mine_monitoring

# MQTT Broker (Mosquitto)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Firebase Admin SDK configuration
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CREDENTIALS_PATH=

# Server Configuration
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://192.168.4.1
ENVIRONMENT=development
GATEWAY_LOCAL_URL=http://192.168.4.1:8000
GATEWAY_API_KEY=

# Alerts and Notifications (SMTP / SMS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@mine-monitoring.local
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM=
ALARM_GPIO_PIN=18
